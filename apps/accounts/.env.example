# URL of the main karasu256.com app (used for the back button in settings)
NEXT_PUBLIC_APP_URL=

# NextAuth — must be the same value across all apps sharing the session cookie
AUTH_SECRET=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-side only — never expose to the client)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# WebAuthn (server-side only)
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_EXPECTED_ORIGIN=

# Cross-subdomain session sharing (optional)
# When set, the session cookie Domain is scoped to .{BASE_DOMAIN} so it is
# shared across all subdomains (e.g. app.example.com, accounts.example.com).
# Leave empty for localhost / single-domain deployments.
BASE_DOMAIN=

# Resend — used to send password-reset emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostgreSQL — used for password-reset tokens
DATABASE_URL=

# Third-party OAuth provider credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-256-GCM key for encrypting third-party access/refresh tokens in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=

# Neon Auth — user data layer (sign-in via Firebase, custom data via Neon Auth)
# Retrieve NEON_AUTH_BASE_URL and NEON_AUTH_JWKS_URL from: neonctl neon-auth status
# Generate NEON_AUTH_COOKIE_SECRET with: openssl rand -base64 32  (must be 32+ chars)
# Generate NEON_AUTH_BRIDGE_SECRET with: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_BRIDGE_SECRET=
