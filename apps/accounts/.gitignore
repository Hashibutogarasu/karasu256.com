# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment variables — plain files are blocked; encrypted files are allowed
.env
.env.development.local
.env.test.local
.env.production.local
# .env.local.unencrypted is the plaintext editing source (blocked by root .gitignore .env*)
# .env.local is encrypted by dotenvx and safe to commit
!.env.local
# private decryption keys must never be committed
.env.keys

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# TypeScript
*.tsbuildinfo
next-env.d.ts
