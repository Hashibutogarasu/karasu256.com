NEXT_PUBLIC_ACCOUNTS_URL=

# NextAuth — must be the same value across all apps sharing the session cookie
AUTH_SECRET=

# Firebase Admin SDK (server-side only — never expose to the client)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Cross-subdomain session sharing (optional)
# When set, the Firebase and NextAuth cookie Domain is scoped to .{BASE_DOMAIN}
# so it is shared across all subdomains (e.g. app.example.com, accounts.example.com).
# Leave empty for localhost / single-domain deployments.
BASE_DOMAIN=

# PostgreSQL (Drizzle ORM)
DATABASE_URL=

# Image upload API (apps/image-api Cloudflare Worker)
NEXT_PUBLIC_IMAGE_API_URL=