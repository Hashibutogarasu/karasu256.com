NEXT_PUBLIC_ACCOUNTS_URL=

# URL of the image-api Worker, used for R2-backed uploads
NEXT_PUBLIC_IMAGE_API_URL=

# Full origin URL of the main karasu256.com app (e.g. https://karasu256.com
# in production, http://localhost:3000 in local dev), used verbatim as the
# settings link destination in the header's account menu (this app has no
# settings page of its own). Required — requests fail if unset.
ROOT_APP_URL=

# Redis connection string, used to cache the current QR code (server-side only)
REDIS_URL=

# Cross-subdomain session sharing (optional)
# When set, session cookies (better-auth's and the legacy Firebase one) are
# cleared with Domain scoped to .{BASE_DOMAIN} to match how
# accounts.karasu256.com originally set them. Leave empty for localhost /
# single-domain deployments.
BASE_DOMAIN=

# This app's own public URL, used as the `next` redirect target after sign-out.
NEXT_PUBLIC_APP_URL=

# PostgreSQL (Drizzle ORM), used to record QR generation history
DATABASE_URL=
