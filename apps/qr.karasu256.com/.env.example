NEXT_PUBLIC_ACCOUNTS_URL=

# URL of the image-api Worker, used for R2-backed uploads
NEXT_PUBLIC_IMAGE_API_URL=

# Root domain of the main karasu256.com app (e.g. karasu256.com in
# production, dev.karasu256.com in preview), used to build the settings
# link destination in the header's account menu (this app has no settings
# page of its own). Required — requests fail if unset.
ROOT_DOMAIN=

# Firebase Admin SDK (server-side only — never expose to the client)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Redis connection string, used to cache the current QR code (server-side only)
REDIS_URL=

# Cross-subdomain session sharing (optional)
# When set, the Firebase session cookie Domain is scoped to .{BASE_DOMAIN}
# so it is shared across all subdomains (e.g. app.example.com, accounts.example.com).
# Leave empty for localhost / single-domain deployments.
BASE_DOMAIN=

# This app's own public URL, used as the `next` redirect target after sign-out.
NEXT_PUBLIC_APP_URL=
