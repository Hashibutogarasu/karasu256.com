{
  "name": "@Hashibutogarasu/karasu-lab-web-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "deploy": "turbo deploy",
    "deploy:prod": "turbo deploy:prod",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec pretty-quick --staged"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "3.5.3",
    "pretty-quick": "4.2.2",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.10.0",
    "typescript": "^5",
    "vercel": "^54.0.0"
  }
}
